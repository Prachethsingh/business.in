generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}


datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

enum OrderStatus {
  PENDING
  SUBMITTED
  APPROVED
  REJECTED
  EXPIRED
}

enum EntitlementStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

enum ReportStatus {
  READY
  REVOKED
}

enum ReviewDecision {
  APPROVE
  REJECT
}

model User {
  id              String     @id @default(cuid())
  email           String     @unique
  passwordHash    String
  name            String?
  role            Role       @default(USER)
  status          UserStatus @default(ACTIVE)
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  sessions            Session[]
  projects            Project[]
  paymentOrders       PaymentOrder[]
  entitlements        Entitlement[]
  auditLogsAsActor    AuditLog[]           @relation("ActorUser")
  paymentReviews      PaymentReview[]
  passwordResetTokens PasswordResetToken[]
  portfolioPins       PortfolioPin[]

  @@index([email])
}

model Session {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  deviceMeta String?
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([tokenHash])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  purpose   String    @default("PASSWORD_RESET")
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Project {
  id           String        @id @default(cuid())
  ownerId      String
  owner        User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name         String
  businessType String
  city         String        @default("Bengaluru")
  status       ProjectStatus @default(ACTIVE)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  locations   Location[]
  simulations Simulation[]

  @@index([ownerId])
}

model Location {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  lat       Float
  lng       Float
  address   String?
  createdAt DateTime @default(now())

  @@index([projectId])
}

model Simulation {
  id           String   @id @default(cuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assumptions  Json
  results      Json?
  modelVersion String   @default("v2.1")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  report            Report?
  monitoringEntries MonitoringEntry[]

  @@index([projectId])
}

model Report {
  id           String       @id @default(cuid())
  simulationId String       @unique
  simulation   Simulation   @relation(fields: [simulationId], references: [id], onDelete: Cascade)
  token        String       @unique
  status       ReportStatus @default(READY)
  snapshot     Json
  revokedAt    DateTime?
  createdAt    DateTime     @default(now())

  @@index([token])
}

model Plan {
  code        String   @id
  name        String
  amountPaise Int
  billingType String   @default("ONE_TIME")
  createdAt   DateTime @default(now())
}

model PaymentOrder {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  planCode    String      @default("PRO")
  amountPaise Int         @default(9900)
  status      OrderStatus @default(PENDING)
  expiresAt   DateTime
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  proof  PaymentProof?
  review PaymentReview?

  @@index([userId, status])
}

model PaymentProof {
  id          String       @id @default(cuid())
  orderId     String       @unique
  order       PaymentOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  utr         String       @unique
  submittedAt DateTime     @default(now())
}

model PaymentReview {
  id         String         @id @default(cuid())
  orderId    String         @unique
  order      PaymentOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  reviewerId String
  reviewer   User           @relation(fields: [reviewerId], references: [id])
  decision   ReviewDecision
  note       String?
  createdAt  DateTime       @default(now())
}

model Entitlement {
  id        String            @id @default(cuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  planCode  String            @default("PRO")
  status    EntitlementStatus @default(ACTIVE)
  grantedAt DateTime          @default(now())
  expiresAt DateTime?
  revokedAt DateTime?

  @@index([userId, status])
}

model BusinessCategory {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  defaults  Json
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  actor       User?    @relation("ActorUser", fields: [actorUserId], references: [id], onDelete: SetNull)
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

model MonitoringEntry {
  id             String     @id @default(cuid())
  simulationId   String
  simulation     Simulation @relation(fields: [simulationId], references: [id], onDelete: Cascade)
  date           DateTime
  actualRevenue  Float
  actualFootfall Int
  notes          String?
  createdAt      DateTime   @default(now())

  @@index([simulationId, date])
}

model PortfolioPin {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  simulationId String?
  lat          Float
  lng          Float
  label        String
  addedAt      DateTime @default(now())

  @@index([userId])
}
